{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-msr.local/schema/project_msr_database-4.3.0.json",
  "title": "Project-MSR Integrated Planner Database Schema v4.3.0",
  "type": "object",
  "required": [
    "meta",
    "project",
    "pathways",
    "pathway_modules",
    "tasks",
    "resources",
    "financials",
    "milestones",
    "risks",
    "design_review_gates",
    "test_matrices",
    "sources",
    "data_quality",
    "licensing_path_table",
    "route_cost_model",
    "planning_profile",
    "implementation_playbooks",
    "fuel_supply_plan",
    "chemistry_processing_plan",
    "implementation_closure_register"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "name",
        "version",
        "generated",
        "project_start",
        "project_end",
        "currency",
        "cost_units",
        "application_version",
        "engineering_work_package_schema",
        "implementation_plan_schema"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "4.3.0"
        },
        "application_version": {
          "const": "4.3.0"
        },
        "generated": {
          "type": "string",
          "minLength": 10
        },
        "project_start": {
          "const": "2026-10-01"
        },
        "project_end": {
          "$ref": "#/$defs/date"
        },
        "currency": {
          "type": "string"
        },
        "cost_units": {
          "type": "string"
        },
        "display_mode": {
          "const": "internal_planning"
        },
        "engineering_work_package_schema": {
          "const": "4.3"
        },
        "implementation_plan_schema": {
          "const": "1.0"
        }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "description",
        "demonstrator_mechanical_completion_target",
        "program_architecture",
        "leadership_principles",
        "planning_start",
        "schedule_targets"
      ],
      "properties": {
        "name": {
          "const": "Project-MSR"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "demonstrator_mechanical_completion_target": {
          "$ref": "#/$defs/date"
        },
        "program_architecture": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "leadership_principles": {
          "type": "object",
          "required": [
            "engineering_authority",
            "technology_development",
            "lean_staffing"
          ],
          "properties": {
            "engineering_authority": {
              "type": "string",
              "minLength": 1
            },
            "technology_development": {
              "type": "string",
              "minLength": 1
            },
            "lean_staffing": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "planning_start": {
          "const": "2026-10-01"
        },
        "schedule_targets": {
          "type": "object",
          "required": [
            "demonstrator_mechanical_completion",
            "demonstrator_authorization_complete",
            "demonstrator_operations_start",
            "demonstrator_operations_complete",
            "commercial_construction_start",
            "commercial_mechanical_completion",
            "commercial_operation_authorization",
            "commercial_initial_criticality",
            "commercial_operation"
          ],
          "properties": {
            "demonstrator_mechanical_completion": {
              "const": "2028-12-31"
            },
            "demonstrator_authorization_complete": {
              "const": "2028-12-31"
            },
            "demonstrator_operations_start": {
              "const": "2029-01-01"
            },
            "demonstrator_operations_complete": {
              "const": "2029-12-31"
            },
            "commercial_construction_start": {
              "const": "2030-01-01"
            },
            "commercial_mechanical_completion": {
              "const": "2034-09-30"
            },
            "commercial_operation_authorization": {
              "const": "2035-03-31"
            },
            "commercial_initial_criticality": {
              "const": "2035-06-30"
            },
            "commercial_operation": {
              "const": "2035-12-31"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "pathways": {
      "type": "object",
      "required": [
        "doe_launchpad",
        "part50",
        "part52",
        "part53",
        "part57"
      ],
      "properties": {
        "doe_launchpad": {
          "$ref": "#/$defs/pathway"
        },
        "part50": {
          "$ref": "#/$defs/pathway"
        },
        "part52": {
          "$ref": "#/$defs/pathway"
        },
        "part53": {
          "$ref": "#/$defs/pathway"
        },
        "part57": {
          "$ref": "#/$defs/pathway"
        }
      },
      "additionalProperties": false
    },
    "pathway_modules": {
      "type": "object",
      "required": [
        "doe_launchpad",
        "part50",
        "part52",
        "part53",
        "part57"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/pathwayModule"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "roles",
        "assignments"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "assignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assignment"
          }
        },
        "capacity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "lean_model": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "financials": {
      "type": "object",
      "additionalProperties": true
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "design_review_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "leadership_governance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "raci": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "test_matrices": {
      "type": "object",
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": true
    },
    "licensing_path_table": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "route_cost_model": {
      "type": "object",
      "additionalProperties": true
    },
    "regulatory_crosswalk": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "regulatory_reference_catalog": {
      "type": [
        "array",
        "object"
      ],
      "items": {
        "type": "object"
      },
      "additionalProperties": true
    },
    "acceleration": {
      "type": "object",
      "additionalProperties": true
    },
    "planning_profile": {
      "type": "object",
      "required": [
        "version",
        "project_start",
        "project_end",
        "year_weights",
        "annual_funding_target_musd",
        "annual_resource_target_fte",
        "ramp_principles"
      ],
      "properties": {
        "version": {
          "const": "4.3.0"
        },
        "project_start": {
          "const": "2026-10-01"
        },
        "project_end": {
          "const": "2038-12-31"
        },
        "year_weights": {
          "type": "object",
          "minProperties": 13,
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "annual_funding_target_musd": {
          "type": "object",
          "minProperties": 13,
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "annual_resource_target_fte": {
          "type": "object",
          "minProperties": 13,
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "ramp_principles": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 20
          }
        }
      },
      "additionalProperties": true
    },
    "implementation_playbooks": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "fuel_supply_plan": {
      "type": "object",
      "required": [
        "playbook_id",
        "title",
        "objective"
      ],
      "additionalProperties": true
    },
    "chemistry_processing_plan": {
      "type": "object",
      "required": [
        "playbook_id",
        "title",
        "objective",
        "experiment_matrix"
      ],
      "properties": {
        "experiment_matrix": {
          "type": "array",
          "minItems": 25,
          "items": {
            "type": "object",
            "required": [
              "test_id",
              "campaign",
              "objective",
              "configuration",
              "material_stage",
              "primary_measurements",
              "analytical_methods",
              "acceptance_basis",
              "model_or_decision_supported",
              "linked_task_ids",
              "planned_window",
              "facility_strategy",
              "required_records"
            ],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "implementation_closure_register": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "closure_id",
          "closure_item",
          "work_required",
          "accountable_functions",
          "need_date",
          "closure_evidence",
          "status"
        ],
        "properties": {
          "closure_id": {
            "type": "string",
            "minLength": 4
          },
          "closure_item": {
            "type": "string",
            "minLength": 10
          },
          "work_required": {
            "type": "string",
            "minLength": 40
          },
          "accountable_functions": {
            "type": "string",
            "minLength": 5
          },
          "need_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "closure_evidence": {
            "type": "string",
            "minLength": 20
          },
          "status": {
            "type": "string",
            "minLength": 2
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "pathway": {
      "type": "object",
      "required": [
        "label",
        "status",
        "summary",
        "variants",
        "default_variant",
        "products"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "products": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variants": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "default_variant": {
          "type": "string",
          "minLength": 1
        },
        "modes": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "warnings"
            ]
          },
          {
            "required": [
              "availability_note"
            ]
          }
        ]
      },
      "additionalProperties": true
    },
    "pathwayModule": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/task"
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "concept",
        "execution_stream",
        "schedule",
        "cost",
        "resources",
        "execution",
        "engineering_work_package",
        "implementation_plan"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 120
        },
        "concept": {
          "type": "string",
          "minLength": 1
        },
        "execution_stream": {
          "type": "string",
          "minLength": 1
        },
        "responsible_role": {
          "type": "string"
        },
        "schedule": {
          "type": "object",
          "required": [
            "start",
            "finish",
            "predecessors"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/date"
            },
            "finish": {
              "$ref": "#/$defs/date"
            },
            "predecessors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "cost": {
          "type": "object",
          "required": [
            "labor_kusd",
            "direct_non_labor_before_risk_kusd",
            "risk_allowance_kusd",
            "non_labor_kusd",
            "total_kusd",
            "low_kusd",
            "high_kusd",
            "estimate_class",
            "estimate_currency_year",
            "estimate_method",
            "productive_hours_per_fte_year",
            "planned_fte_years",
            "planned_labor_hours",
            "labor_effort_breakdown",
            "blended_loaded_rate_kusd_per_fte_year",
            "basis_of_estimate_id",
            "estimate_status",
            "reestimate_triggers",
            "cost_components",
            "prior_estimate",
            "estimate_change",
            "cost_drivers",
            "exclusions_and_double_counting_controls"
          ],
          "properties": {
            "labor_kusd": {
              "type": "number",
              "minimum": 0
            },
            "direct_non_labor_before_risk_kusd": {
              "type": "number",
              "minimum": 0
            },
            "risk_allowance_kusd": {
              "type": "number",
              "minimum": 0
            },
            "non_labor_kusd": {
              "type": "number",
              "minimum": 0
            },
            "total_kusd": {
              "type": "number",
              "minimum": 0
            },
            "low_kusd": {
              "type": "number",
              "minimum": 0
            },
            "high_kusd": {
              "type": "number",
              "minimum": 0
            },
            "estimate_class": {
              "type": "string",
              "minLength": 1
            },
            "estimate_currency_year": {
              "type": "integer",
              "const": 2026
            },
            "estimate_method": {
              "type": "string",
              "minLength": 1
            },
            "productive_hours_per_fte_year": {
              "type": "integer",
              "minimum": 1
            },
            "planned_fte_years": {
              "type": "number",
              "minimum": 0
            },
            "planned_labor_hours": {
              "type": "number",
              "minimum": 0
            },
            "labor_effort_breakdown": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "blended_loaded_rate_kusd_per_fte_year": {
              "type": "number",
              "minimum": 0
            },
            "basis_of_estimate_id": {
              "type": "string",
              "minLength": 1
            },
            "estimate_status": {
              "type": "string",
              "minLength": 1
            },
            "reestimate_triggers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "cost_components": {
              "type": "object",
              "required": [
                "external_engineering_and_lab_services_kusd",
                "software_compute_and_data_kusd",
                "equipment_materials_and_fabrication_kusd",
                "facility_test_and_field_operations_kusd",
                "regulatory_review_fees_kusd",
                "legal_hearing_and_advisory_kusd",
                "travel_and_field_support_kusd",
                "other_direct_kusd",
                "risk_allowance_kusd"
              ],
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "prior_estimate": {
              "type": "object",
              "required": [
                "version",
                "labor_kusd",
                "non_labor_kusd",
                "total_kusd",
                "fte_years"
              ],
              "additionalProperties": true
            },
            "estimate_change": {
              "type": "object",
              "required": [
                "labor_delta_kusd",
                "non_labor_delta_kusd",
                "total_delta_kusd",
                "total_change_pct",
                "reason"
              ],
              "additionalProperties": true
            },
            "cost_drivers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclusions_and_double_counting_controls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allocated_program_package_kusd": {
              "type": "number",
              "minimum": 0
            },
            "allocated_program_package_sources": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "fully_burdened_task_view_kusd": {
              "type": "number",
              "minimum": 0
            },
            "fully_burdened_view_is_non_additive": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": [
              "object",
              "string"
            ]
          }
        },
        "execution": {
          "type": "object",
          "required": [
            "purpose",
            "required_inputs",
            "work_steps",
            "tools_and_methods",
            "deliverables_and_records",
            "acceptance_exit_criteria",
            "minimum_technical_content",
            "engineering_ready"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 80
            },
            "required_inputs": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 8
              }
            },
            "work_steps": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "string",
                "minLength": 8
              }
            },
            "tools_and_methods": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 3
              }
            },
            "deliverables_and_records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 3
              }
            },
            "acceptance_exit_criteria": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 8
              }
            },
            "minimum_technical_content": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 8
              }
            },
            "engineering_ready": {
              "const": true
            }
          },
          "additionalProperties": true
        },
        "engineering_work_package": {
          "$ref": "#/$defs/engineeringWorkPackage"
        },
        "implementation_plan": {
          "$ref": "#/$defs/implementationPlan"
        }
      },
      "not": {
        "required": [
          "provisional"
        ]
      },
      "additionalProperties": true
    },
    "engineeringWorkPackage": {
      "type": "object",
      "required": [
        "engineering_readiness_level",
        "primary_domain",
        "work_pattern",
        "scope_statement",
        "objective",
        "entry_criteria",
        "controlled_inputs",
        "execution_procedure",
        "requirements_and_guidance",
        "toolchain",
        "deliverable_register",
        "verification_and_validation",
        "interfaces",
        "risks_and_controls",
        "quality_records",
        "definition_of_done",
        "resource_plan",
        "execution_controls",
        "planning_and_decision_context",
        "engineering_checks",
        "acceptance_metrics",
        "handoff_checklist",
        "field_and_test_readiness",
        "estimating_and_schedule_basis",
        "engineering_questions_to_close",
        "minimum_execution_record",
        "required_reviews_and_hold_points",
        "schedule_logic_and_parallelization"
      ],
      "properties": {
        "engineering_readiness_level": {
          "type": "string",
          "minLength": 1
        },
        "primary_domain": {
          "type": "string",
          "minLength": 1
        },
        "supporting_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "work_pattern": {
          "type": "string",
          "minLength": 1
        },
        "scope_statement": {
          "type": "string",
          "minLength": 100
        },
        "objective": {
          "type": "string",
          "minLength": 30
        },
        "entry_criteria": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "controlled_inputs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/inputRecord"
          }
        },
        "execution_procedure": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/procedureStep"
          }
        },
        "requirements_and_guidance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "toolchain": {
